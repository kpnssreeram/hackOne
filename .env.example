# Copy this to .env and fill in your values
OPENAI_API_KEY=sk-proj-...
# Optional: change the cover-art model without changing application code.
OPENAI_IMAGE_MODEL=gpt-image-1
# Optional: the explicit 20-second vertical teaser uses this video model.
OPENAI_VIDEO_MODEL=sora-2
ELEVENLABS_API_KEY=sk_...

# Hindi uses the dependable multilingual model. Telugu and expressive dialogue
# automatically use the v3 model below; override only when your account uses
# a different supported ElevenLabs model name.
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_EXPRESSIVE_TTS_MODEL=eleven_v3

# Runtime mode: live | hybrid | replay
NOLAN_MODE=hybrid

# ElevenLabs voice IDs. These default IDs are in the standard premade catalogue.
# You can replace them with voices available to your own ElevenLabs account.
VOICE_ID_NARRATOR=SAz9YHcvj6GT2YYXdXww
VOICE_ID_FEMALE=pFZP5JQG7iQjIQuC4Bku
VOICE_ID_MALE=iP95p4xoKVk53GoZ742B

# Circuit breaker per-stage hard timeouts (seconds)
TIMEOUT_TRANSCRIBE=20
TIMEOUT_DNA=25
TIMEOUT_VISIONS=35
TIMEOUT_SCRIPT=35
TIMEOUT_CONSTITUTION=25
TIMEOUT_REVISION=30
TIMEOUT_AUDIO=180

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
